# Пароль для входа в админку. Обязательно смените.
ADMIN_PASSWORD=change-me-please

# Публичный адрес сервера — попадает в ссылки внутри manifest.json.
# Задавайте явно: так ссылки гарантированно https, а не то, что придёт в заголовках.
PUBLIC_URL=https://launcher.example.com

# Репозиторий с релизами лаунчера — из него страница /download берёт свежую версию.
GITHUB_REPO=r0-0ky/g-launcher

# --- Вход игроков через Telegram ---

# Токен бота от @BotFather и его имя без «@».
# Без обоих значений вход выключен, лаунчер это понимает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Любая случайная строка: Telegram присылает её заголовком, по ней отсекаются
# чужие запросы на вебхук. Придумайте свою, например `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET=

# Сколько дней живёт вход в лаунчере (по умолчанию 30).
# ACCOUNT_SESSION_TTL_DAYS=30

# --- Магазин ---

# Можно ли игрокам заливать свои скины и плащи. Поставьте false, если косметика
# должна браться только из магазина: тогда заливает лишь админка, а лаунчер
# сам прячет кнопки загрузки.
# ALLOW_PLAYER_UPLOADS=true

# --- Скины: Cloudflare R2 ---

# Все четыре значения обязательны вместе. Не заданы — скины лягут на диск
# сервера, в DATA_DIR/skins, и всё будет работать так же, только трафик пойдёт
# через VPS.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Публичный адрес бакета: r2.dev или свой домен. Задан — за скинами игроков
# отправляем прямо туда, и раздача идёт мимо нашего сервера.
# R2_PUBLIC_URL=https://skins.onlyg.land

# --- Только на VPS (локальной разработке не нужны) ---

# Образ сервера, который выкладывает GitHub Actions.
# Откат на предыдущую версию: подставьте sha-<коммит> вместо latest.
SERVER_IMAGE=ghcr.io/r0-0ky/g-launcher/server:latest

# --- Оплата G-коинов картой (Т-банк) ---

# Терминал и его пароль из личного кабинета Т-банка. Без обоих значений
# пополнение кошелька в лаунчере просто не показывается.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# Куда банк вернёт игрока после оплаты. Платит он в браузере, а результат
# лаунчер узнаёт опросом, так что страница нужна только для человека.
# TBANK_RETURN_URL=https://launcher.example.com/download

# Необязательное
# Токен GitHub (read-only, public_repo): нужен, только если упираетесь в лимит API.
# GITHUB_TOKEN=
# Внешняя docker-сеть, в которой стоит reverse-proxy.
# PROXY_NETWORK=web
# Боевой адрес API банка. Меняют разве что для тестового контура.
# TBANK_API_URL=https://securepay.tinkoff.ru/v2
# PORT=8080
# DATA_DIR=/data
# Размер загружаемого мода по умолчанию не ограничен — ни сервером, ни nginx.
# Переменная нужна, только если впереди поставили прокси со своим лимитом: тогда
# админка отдаст понятную ошибку вместо обрыва загрузки.
# MAX_UPLOAD_MB=95
# SESSION_TTL_HOURS=24
# LOG_LEVEL=info
