# /etc/nginx/sites-available/launcher.example.com
# Сертификат ставится командой: certbot --nginx -d launcher.example.com

server {
    listen 80;
    server_name launcher.example.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name launcher.example.com;

    ssl_certificate     /etc/letsencrypt/live/launcher.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/launcher.example.com/privkey.pem;

    # Моды весят десятки мегабайт — иначе загрузка в админке упрётся в лимит.
    client_max_body_size 600m;

    # Раздача jar-ов идёт потоком, ускорения от буферизации нет.
    proxy_buffering off;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }

    # Файлы адресуются по хэшу, поэтому их можно кэшировать вечно.
    location /files/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
