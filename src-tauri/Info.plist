<?xml version="1.0" encoding="UTF-8"?>
<!--
  Дополнения к Info.plist сборки под macOS: Tauri сам подхватывает этот файл,
  раз он лежит рядом с tauri.conf.json, и сливает со своим.

  Микрофон нужен не самому лаунчеру, а игре: моды голосового чата (Simple Voice
  Chat и подобные) просят его изнутри Minecraft. Но игра — дочерний процесс
  лаунчера, и macOS спрашивает разрешение у родителя. Без строки-объяснения
  система даже не покажет запрос: она молча откажет, и в игре просто не будет
  звука с микрофона.
-->
<plist version="1.0">
  <dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Чтобы говорить в голосовом чате Minecraft.</string>

    <!-- Некоторые сборки просят и камеру: без описания игра упадёт на запросе,
         а не получит вежливый отказ. -->
    <key>NSCameraUsageDescription</key>
    <string>Чтобы моды с видеосвязью могли показать вас в игре.</string>

    <!-- Игра ходит в сеть сама, минуя лаунчер: серверы, карты, моды. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Чтобы находить серверы Minecraft в локальной сети.</string>
  </dict>
</plist>
